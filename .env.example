# Replace the owner with the lower-case GitHub username/organization hosting the image.
# Select a reviewed exact tag for production; latest moves on controlled publication.
MANAGER_IMAGE=ghcr.io/zdb00/managerio-docker:latest
MANAGER_DATA_PATH=./data
MANAGER_BIND_ADDRESS=0.0.0.0
MANAGER_PORT=8080
TZ=Australia/Perth
PUID=1000
PGID=1000
UMASK=0027
# Unraid commonly uses PUID=99 PGID=100; confirm your host permissions first.
